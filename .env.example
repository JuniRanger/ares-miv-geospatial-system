API_PREFIX=/api/v1
API_VERSION=1.1.0
CORS_ORIGINS=http://localhost:5173
DATA_LOCAL_DIR=./data/processed
RUTA_PENDIENTE=./data/processed/slope_5m.tif
DATA_FILE_PATH=./data/static/layers.json
VISUAL_DATA_DIR=./data/visual

# AWS credentials: leave blank to use the standard boto3 credential chain.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-2

# AWS S3: configure a read-only principal for this object.
S3_BUCKET=mars-terrain-data-2026
S3_KEY=slope_5m.tif
S3_REGION=us-east-2
S3_ENDPOINT_URL=

# Dataset integrity (optional)
S3_VERSION_ID=
S3_SHA256=

# Render ephemeral cache (override DATA_LOCAL_DIR and RUTA_PENDIENTE):
DATA_LOCAL_DIR=/tmp/mars-data
RUTA_PENDIENTE=/tmp/mars-data/slope_5m.tif
