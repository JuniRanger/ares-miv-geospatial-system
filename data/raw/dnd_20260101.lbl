/* DESCRIPTIVE DATA ELEMENTS */
INSTRUMENT_HOST_NAME           = "2001 MARS ODYSSEY"
INSTRUMENT_NAME                = "GAMMA RAY SPECTROMETER"
SPACECRAFT_ID                  = ODY
TARGET_NAME                    = MARS
MISSION_PHASE_NAME             = "EXTENDED MISSION"
START_TIME                     = 2026-01-01T00:00:14.396
STOP_TIME                      = 2026-01-01T23:59:50.351
SPACECRAFT_CLOCK_START_COUNT   = "371633614273"
SPACECRAFT_CLOCK_STOP_COUNT    = "371655726535"
PRODUCT_CREATION_TIME          = 2026-09-22T13:08:32

/* DATA OBJECT DEFINITION */
OBJECT                         = TIME_SERIES

  INTERCHANGE_FORMAT           = BINARY
  ROWS                         = 4170
