^TIME_SERIES                   = "DND_20260101.DAT"

/* IDENTIFICATION DATA ELEMENTS */
DATA_SET_NAME                  = "ODY MARS GAMMA RAY SPECTROMETER 4 DND V2.0"
DATA_SET_ID                    = "ODY-M-GRS-4-DND-V2.0"
PRODUCT_ID                     = "DND_20260101"
