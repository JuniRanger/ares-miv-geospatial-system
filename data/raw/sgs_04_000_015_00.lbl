INSTRUMENT_NAME                = "GAMMA RAY SPECTROMETER"
SPACECRAFT_ID                  = ODY
TARGET_NAME                    = MARS
MISSION_PHASE_NAME             = "EXTENDED MISSION"
CENTER_LATITUDE                = 87.5
START_TIME                     = 2007-12-10T00:02:16.974
STOP_TIME                      = 2008-01-09T23:07:47.224
START_SOLAR_LONGITUDE          = 000
STOP_SOLAR_LONGITUDE           = 015
SPACECRAFT_CLOCK_START_COUNT   = 225718397615
SPACECRAFT_CLOCK_STOP_COUNT    = 226403232167
