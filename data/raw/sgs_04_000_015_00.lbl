/* DATA OBJECT DEFINITION */
OBJECT                         = TABLE

  INTERCHANGE_FORMAT           = BINARY
  ROWS                         = 72
  ROW_BYTES                    = 131356

  /* The complete column definitions are contained in an external file */
  /* found in the LABEL directory of the archive disk.                 */
  
  COLUMNS                      = 54
  ^STRUCTURE                   = "SUMMED_GAMMA_SPECTRA_COLS.FMT"

  /* DESCRIPTIVE data elements */

  DESCRIPTION                  = "

     The SGS product contains sums of corrected gamma spectra with
     ancillary data. The data has been summed spatially over a 
     5 degree by 5 degree grid and temporally over intervals of 15
     degrees of solar longitude.

     The SGS product data is presented in a tables corresponding to 
     the 36 latitude bands of the 5x5 degree grid.

     This file is for the band centered at 87.5 degrees latitude.
    
     Within each band, longitude increases eastward from the cell
     centered at 2.5 degrees east longitude to the cell centered at 
     357.5 degrees east longitude.
  "

END_OBJECT                     = TABLE

